# ─────────────────────────────────────────────
# CampusIQ Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Application
APP_NAME=CampusIQ
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://campusiq:campusiq_password@localhost:5432/campusiq_db
DATABASE_URL_SYNC=postgresql+psycopg2://campusiq:campusiq_password@localhost:5432/campusiq_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Groq AI (LLM)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Embeddings (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@campusiq.edu
EMAILS_FROM_NAME=CampusIQ Platform
EMAILS_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://campusiq.edu"]

# Business Rules
MAX_REGISTRATIONS_PER_STUDENT=10
RAG_TOP_K_RESULTS=5
AI_TARGETING_TOP_N=20
